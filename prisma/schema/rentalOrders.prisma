model RentalOrder {
  id          String       @id @default(uuid())
  customerId  String
  startDate   DateTime
  endDate     DateTime
  totalAmount Decimal      @default(0) @db.Decimal(10, 2)
  status      RentalStatus @default(PLACED)

  customer User @relation("CustomerRentalOrders", fields: [customerId], references: [id], onDelete: Restrict)

  items RentalOrderItem[]

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@map("rental_orders")
}

model RentalOrderItem {
  id            String  @id @default(uuid())
  rentalOrderId String
  gearItemId    String
  quantity      Int     @default(1)
  pricePerDay   Decimal @db.Decimal(10, 2)

  rentalOrder RentalOrder @relation(fields: [rentalOrderId], references: [id], onDelete: Cascade)
  gearItem    GearItem    @relation(fields: [gearItemId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rentalOrderId, gearItemId])
  @@map("rental_order_items")
}

enum RentalStatus {
  PLACED
  CONFIRMED
  PAID
  PICKED_UP
  RETURNED
  CANCELLED
}