  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://gear-up-ivory-nine.vercel.app/api/auth/register",
              "host": [
                "gear-up-ivory-nine",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"pass1234\",\n  \"role\": \"CUSTOMER\",\n  \"profilePhoto\": \"\",\n  \"phone\": \"01700000000\",\n  \"bio\": \"\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json?.data?.jwtAccessToken) {",
                  "  pm.collectionVariables.set('token', json.data.jwtAccessToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "https://gear-up-ivory-nine.vercel.app/api/auth/login",
              "host": [
                "gear-up-ivory-nine",
                "vercel",
                "app"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ],
              "protocol": "https"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"pass1234\"\n}"
            }
          }
        },
        {
          "name": "Get Current User (me)",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
